# ============================================
# ApnaTutorHub — Environment Credentials Example
# ============================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Platform Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-jwt-key"
SUPABASE_SERVICE_ROLE_JWT="your-service-role-jwt-key"

# Database Connection (Supabase PostgreSQL / Pooler)
# DATABASE_URL: Transaction Pooler URL (port 6543) for Next.js App Runtime & Workers
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL: Direct Postgres URL (port 5432) for Prisma Migrations & CLI
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Auth.js v5
AUTH_SECRET="your-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Email Delivery (Resend or AWS SES) ───────────────────────────────────────
# Recommended: Resend (Free 3,000 emails/month, instant setup)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="ApnaTutorHub <noreply@mail.apnatutorhub.com>"

# AWS S3 & SES (optional fallback)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME=""
AWS_SES_SENDER_EMAIL=""

# Redis / Upstash  (required for BullMQ background workers — `npm run worker`)
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Web Push Notifications (VAPID) ────────────────────────────────────────────
# Lets users receive OS push notifications even when the site is not open.
#
# 1. Generate your VAPID keys once (one-time setup):
#    npx web-push generate-vapid-keys
#
# 2. Copy the output below:
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact email shown to push services (must be mailto: format)
VAPID_CONTACT_EMAIL="mailto:support@thinktutorindia.com"

# ── Typesense Search (optional) ───────────────────────────────────────────────
# Falls back to Postgres full-text search when not configured.
TYPESENSE_HOST=""
TYPESENSE_API_KEY=""
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="https"

# ── Sentry Error Monitoring (optional) ────────────────────────────────────────
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
