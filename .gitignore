# ============================================
# ApnaTutorHub — Enterprise Git Ignore Rules
# ============================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Production Outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# ============================================
# CRITICAL SECURITY & SENSITIVE CREDENTIALS
# ============================================
# Environment files (NEVER commit real credentials)
.env
.env.*
!.env.example

# Master credentials workbooks, keys, and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*credentials*
*secret*
*.id_rsa*

# Excel & Spreadsheet files (contains credentials or customer data)
*.xlsx
*.xls
*.xlsm

# CSV and Tabular Data Dumps (Calling sheets, customer PII)
*.csv
mitali_*
staff_performance_*

# Local Database & Raw Data Repositories
/data/
/datauploadrawdata/
/whattodo/
whattodo.zip
*.zip

# Development Sandboxes & Scratchpad (Contains hardcoded test tokens)
/scratch/
!/scratch/README.md

# Python Virtual Environments & Caches
/.venv/
/venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Operating System & IDE Clutter
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel Deployment Metadata
.vercel
