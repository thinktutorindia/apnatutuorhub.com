// Prisma 6/7 Schema — ThinkTutor
// Phase 1: Foundation models (User, Auth, Profiles, Wallet)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────

enum UserRole {
  PARENT
  TUTOR
  SUPER_ADMIN
  SUB_ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  NONE
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum SubAdminRole {
  SUPPORT
  VERIFICATION
  FINANCE
  OPERATIONS
  MARKETING
}

enum TeachingMode {
  ONLINE
  OFFLINE
  EITHER
}

enum LeadStatus {
  ACTIVE
  MATCHING
  APPLICATIONS_RECEIVED
  BOOKED
  COMPLETED
  EXPIRED
  CLOSED
}

enum WalletTransactionType {
  PURCHASE
  DEDUCTION
  REFUND
  BONUS
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  WEB
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  SEEN
  CLICKED
  FAILED
  EXPIRED
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

enum DummyCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
}

enum DummyTargetGroup {
  ALL_TUTORS
  NEW_7D
  NEW_14D
  NEW_30D
  VERIFIED
  UNVERIFIED
  SUBSCRIBED
  FREE_TIER
  CUSTOM
}

// ────────────────────────────────────────────────
// User & Auth
// ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?   @unique
  image         String?
  role          UserRole  @default(PARENT)
  referralCode  String?   @unique
  isActive      Boolean   @default(true)
  /// Web Push VAPID subscription object (endpoint + keys). Stored as JSON.
  pushSubscription Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  parentProfile    ParentProfile?
  tutorProfile     TutorProfile?
  subAdminRole     SubAdminRole?
  customPermissions String[]     @default([])
  couponUsages     CouponUsage[]
  referralsSent    Referral[]     @relation("ReferrerRel")
  referralReceived Referral?      @relation("RefereeRel")

  // Notifications & Messages
  notifications      Notification[]
  userActivities     UserActivity[]
  sentMessages       Message[]
  adminNotesReceived AdminNote[]   @relation("AdminNotesTarget")
  adminNotesAuthored AdminNote[]   @relation("AdminNotesAuthor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ────────────────────────────────────────────────
// Parent Profile & Student Profiles
// ────────────────────────────────────────────────

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  city      String?
  state     String?
  pincode   String?
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      StudentProfile[]
  leads         Lead[]
  conversations Conversation[]

  @@map("parent_profiles")
}

model StudentProfile {
  id              String   @id @default(cuid())
  parentProfileId String
  name            String
  classLevel      String
  board           String?
  subjects        String[]
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)

  @@index([parentProfileId])
  @@map("student_profiles")
}

// ────────────────────────────────────────────────
// Tutor Profile & KYC
// ────────────────────────────────────────────────

model TutorProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  bio              String?      @db.Text
  qualification    String?
  experience       Int?         // years
  subjects         String[]
  classLevels      String[]
  teachingMode     TeachingMode @default(EITHER)
  teachingRadius   Int          @default(10) // km
  feeMin           Int?
  feeMax           Int?
  latitude         Float?
  longitude        Float?
  city             String?
  state            String?
  pincode          String?
  address          String?
  introVideoUrl    String?
  profileScore     Int          @default(0)
  averageRating    Float        @default(0)
  totalReviews     Int          @default(0)
  isVerified       Boolean      @default(false)
  isFeatured       Boolean      @default(false)
  kycStatus        KycStatus    @default(NOT_SUBMITTED)
  kycIdProofUrl    String?
  kycAddressUrl    String?
  kycSelfieUrl     String?
  kycRejectionNote String?
  subscriptionPlan SubscriptionPlan @default(NONE)
  subscriptionExpiresAt DateTime?
  leadsUsedThisMonth Int        @default(0)
  leadsResetAt     DateTime?

  // ── Onboarding Wizard Fields ────────────────────────────────────────────────
  onboardingStep      Int      @default(0)     // 0=not started, 1-7=step completed, 7=all done
  gender              String?                  // "MALE" | "FEMALE"
  teachingStartYear   Int?                     // Year they started teaching
  educationCourse     String?                  // e.g., "BSc, B.Ed"
  educationSubjects   String?                  // Subjects studied in college
  educationUniversity String?                  // University name
  educationYear       String?                  // Year of passing or "Pursuing"
  profession          String?                  // Current profession
  dateOfBirth         String?                  // Date of birth (stored as string)
  referralSource      String?                  // How they found us
  maritalStatus       String?                  // "MARRIED" | "UNMARRIED"
  interestedIn        String[]                 // ["HOME_TUTORING", "ONLINE_TUTORING", ...]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       Review[]
  wallet        Wallet?
  bookings      Booking[]
  purchases     LeadPurchase[]
  availability  TutorAvailability[]
  conversations Conversation[]
  subscriptions TutorSubscription[]

  @@map("tutor_profiles")
}

model TutorAvailability {
  id             String @id @default(cuid())
  tutorProfileId String
  dayOfWeek      Int    // 0=Sun, 6=Sat
  startTime      String // "09:00"
  endTime        String // "17:00"

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@map("tutor_availability")
}

model TutorSubscription {
  id                String           @id @default(cuid())
  tutorProfileId    String
  plan              SubscriptionPlan
  priceInr          Int              // Annual price in INR
  razorpayOrderId   String?
  razorpayPaymentId String?
  startDate         DateTime         @default(now())
  endDate           DateTime
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
  @@map("tutor_subscriptions")
}

// ────────────────────────────────────────────────
// Wallet & Coins
// ────────────────────────────────────────────────

model Wallet {
  id             String   @id @default(cuid())
  tutorProfileId String   @unique
  balance        Int      @default(0)
  totalPurchased Int      @default(0)
  totalSpent     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tutorProfile TutorProfile        @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  type        WalletTransactionType
  amount      Int
  balanceAfter Int
  description String?
  referenceId String?               // payment ID, lead ID, etc.
  createdAt   DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, referenceId, type])
  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model CoinPackage {
  id         String   @id @default(cuid())
  name       String
  coins      Int
  bonusCoins Int      @default(0)
  priceInr   Int      // in paise
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("coin_packages")
}

// ────────────────────────────────────────────────
// Leads & Matching
// ────────────────────────────────────────────────

model Lead {
  id               String     @id @default(cuid())
  parentProfileId  String
  studentProfileId String?
  subjects         String[]
  classLevel       String
  board            String?
  mode             TeachingMode
  budgetMin        Int?
  budgetMax        Int?
  latitude         Float?
  longitude        Float?
  city             String?
  area             String?
  pincode          String?
  timingPreference String?
  tutorGenderPref  String?    // MALE, FEMALE, ANY
  languagePref     String?
  notes            String?    @db.Text
  status           LeadStatus @default(ACTIVE)
  coinCost         Int        @default(10)
  maxTutors        Int        @default(5)
  purchaseCount    Int        @default(0)
  radiusKm         Int        @default(10)
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  parentProfile ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  purchases     LeadPurchase[]
  bookings      Booking[]
  conversations Conversation[]

  @@index([parentProfileId, createdAt])
  @@index([status, createdAt])
  @@index([classLevel, status])
  @@map("leads")
}

model LeadPurchase {
  id             String   @id @default(cuid())
  leadId         String
  tutorProfileId String
  coinsSpent     Int
  proposalNote   String?  @db.Text
  feeQuote       Int?
  isShortlisted  Boolean  @default(false)
  isHired        Boolean  @default(false)
  isRejected     Boolean  @default(false)
  createdAt      DateTime @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([leadId, tutorProfileId])
  @@index([tutorProfileId])
  @@map("lead_purchases")
}

// ────────────────────────────────────────────────
// Bookings
// ────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  leadId         String
  tutorProfileId String
  parentName     String?
  tutorName      String?
  subject        String
  classLevel     String
  mode           TeachingMode
  status         BookingStatus @default(REQUESTED)
  startDate      DateTime?
  classFrequency String?       // "3x/week"
  meetLink       String?
  venueAddress   String?
  agreedFee      Int?
  isTrial        Boolean       @default(false)
  cancelledBy    String?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@index([tutorProfileId, status])
  @@map("bookings")
}

// ────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────

model Review {
  id              String   @id @default(cuid())
  bookingId       String
  tutorProfileId  String
  reviewerUserId  String
  reviewerRole    UserRole
  teachingRating  Int?     // 1-5
  communicationRating Int? // 1-5
  punctualityRating   Int? // 1-5
  overallRating   Int      // 1-5
  comment         String?  @db.Text
  isEditable      Boolean  @default(true)
  editLockedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reviewerUserId])
  @@map("reviews")
}

// ────────────────────────────────────────────────
// Notifications
// ────────────────────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        String               @default("GENERIC") // e.g. LEAD_MATCHED, KYC_APPROVED
  priority    NotificationPriority @default(NORMAL)
  channel     NotificationChannel  @default(WEB)
  status      DeliveryStatus       @default(PENDING)
  title       String
  message     String
  actionUrl   String?
  isRead      Boolean              @default(false)
  scheduledAt DateTime             @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  seenAt      DateTime?
  clickedAt   DateTime?
  retryCount  Int                  @default(0)
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, status, createdAt])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String         @id @default(cuid())
  notificationId    String
  provider          String         // "AWS_SES", "AWS_SNS", "TWILIO"
  channel           String         // "EMAIL", "PUSH", "SMS", "WHATSAPP"
  providerMessageId String?
  status            DeliveryStatus @default(PENDING)
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

// ────────────────────────────────────────────────
// Audit Log
// ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("audit_logs")
}

model AdminNote {
  id           String   @id @default(cuid())
  targetUserId String
  authorUserId String
  authorName   String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  targetUser User @relation("AdminNotesTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorUser User @relation("AdminNotesAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@map("admin_notes")
}

// ────────────────────────────────────────────────
// User Activity Logs (Phase 13)
// Tracks all user-facing platform events (separate from admin AuditLog)
// ────────────────────────────────────────────────

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  event     String   // e.g. "LEAD_PURCHASED", "BOOKING_COMPLETED"
  ipAddress String?
  userAgent String?
  metadata  Json?    // Contextual data: leadId, bookingId, coinCost, etc.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("user_activity")
}

// ────────────────────────────────────────────────
// Real-time Chat & Messaging (Phase 2)
// ────────────────────────────────────────────────

model Conversation {
  id              String   @id @default(cuid())
  leadId          String?
  parentProfileId String
  tutorProfileId  String
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  tutorProfile  TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([parentProfileId, tutorProfileId, leadId])
  @@index([parentProfileId, lastMessageAt])
  @@index([tutorProfileId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String   @db.Text
  attachmentUrl  String?
  isRead         Boolean  @default(false)
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ────────────────────────────────────────────────
// Platform Settings
// ────────────────────────────────────────────────

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String?

  @@map("platform_settings")
}

// ────────────────────────────────────────────────
// Coupons & Rewards
// ────────────────────────────────────────────────

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  discountType   CouponDiscountType
  discountAmount Int                // percentage (e.g. 20 for 20%) or flat in paise (e.g. 10000 = ₹100)
  maxDiscountInr Int?               // max discount cap in paise for percentage coupons
  minOrderInr    Int?               // min order value in paise
  usageLimit     Int?               // global max usages allowed
  usedCount      Int                @default(0)
  expiresAt      DateTime?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?  // transaction or payment reference ID
  discount  Int      // actual discount applied in paise
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ────────────────────────────────────────────────
// Referrals
// ────────────────────────────────────────────────

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  refereeId    String         @unique
  code         String
  status       ReferralStatus @default(PENDING)
  rewardCoins  Int            @default(50)
  refereeCoins Int            @default(25)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  referrer User @relation("ReferrerRel", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("RefereeRel", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

// ────────────────────────────────────────────────
// Dummy Lead Campaign System
// ────────────────────────────────────────────────

model DummyCampaign {
  id              String                @id @default(cuid())
  name            String
  description     String?               @db.Text
  status          DummyCampaignStatus   @default(DRAFT)
  targetGroup     DummyTargetGroup      @default(ALL_TUTORS)
  customUserIds   String[]              @default([])  // used when targetGroup = CUSTOM
  excludeUserIds  String[]              @default([])  // never send to these users
  channels        String[]              @default([])  // "EMAIL" | "PUSH" | "IN_APP"
  leadsPerDay     Int                   @default(1)   // leads per tutor per day
  randomizeDaily  Boolean               @default(true)// rotate lead content each day
  overrideSubjects String[]             @default([])  // empty = use tutor's own subjects
  budgetMin       Int                   @default(800)
  budgetMax       Int                   @default(3000)
  totalLimit      Int?                              // auto-stop after N total sends (null = unlimited)
  startDate       DateTime?
  endDate         DateTime?
  totalSent       Int                   @default(0)
  totalFailed     Int                   @default(0)
  lastRunAt       DateTime?
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  logs CampaignDeliveryLog[]

  @@index([status, createdAt])
  @@map("dummy_campaigns")
}

model CampaignDeliveryLog {
  id           String   @id @default(cuid())
  campaignId   String
  userId       String
  userName     String?
  userEmail    String
  channel      String   // "EMAIL" | "PUSH" | "IN_APP"
  status       String   // "SENT" | "FAILED"
  leadData     Json     // full dummy lead snapshot sent
  errorMessage String?  @db.Text
  sentAt       DateTime @default(now())

  campaign DummyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sentAt])
  @@index([userId, sentAt])
  @@index([sentAt])
  @@map("campaign_delivery_logs")
}
